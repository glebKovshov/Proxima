{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "core-tests",
      "displayName": "Proxima core and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROXIMA_BUILD_DESKTOP": "OFF",
        "PROXIMA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "desktop-release",
      "displayName": "Proxima desktop Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROXIMA_BUILD_DESKTOP": "ON",
        "PROXIMA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "core-tests", "configurePreset": "core-tests" },
    { "name": "desktop-release", "configurePreset": "desktop-release" }
  ],
  "testPresets": [
    { "name": "core-tests", "configurePreset": "core-tests", "output": { "outputOnFailure": true } },
    { "name": "desktop-release", "configurePreset": "desktop-release", "output": { "outputOnFailure": true } }
  ]
}
